FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Pilihan vector store: local_json, faiss, pgvector.
# Produksi Neon memakai pgvector; local_json cocok untuk pengembangan lokal.
VECTOR_DB_TYPE=local_json
# Pilihan: langchain, manual.
# langchain adalah engine utama. manual hanya untuk pembanding/legacy.
RAG_ENGINE=langchain
CHUNK_SIZE=900
CHUNK_OVERLAP=120
TOP_K=4
SIMILARITY_THRESHOLD=0.30

# Pilihan produksi: auto, groq, atau gemini. Mode auto mencoba Gemini dahulu,
# kemudian Groq, lalu jawaban ekstraktif deterministik dari konteks.
# ollama hanya disediakan untuk eksperimen lokal terkontrol.
LLM_PROVIDER=auto
GROQ_API_KEY=isi_api_key_groq_di_file_env_lokal
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=isi_api_key_gemini_di_file_env_lokal
GEMINI_MODEL=gemini-3.5-flash-lite

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# PostgreSQL eksternal (Neon) untuk akun dan histori. Untuk lokal gunakan:
# DATABASE_URL=sqlite:///data/app.db
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
JWT_SECRET=ganti-dengan-random-minimal-32-karakter
# Harus sama dengan secret ORIGIN_SHARED_SECRET pada Cloudflare Worker.
# Digunakan agar endpoint Modal hanya menerima request dari Worker.
ORIGIN_SHARED_SECRET=ganti-dengan-random-berbeda-minimal-32-karakter
ACCESS_TOKEN_MINUTES=480
CHAT_RETENTION_DAYS=30
MAX_REQUEST_BODY_BYTES=65536
GUEST_CHAT_RATE_PER_MINUTE=6
USER_CHAT_RATE_PER_MINUTE=15
GLOBAL_CHAT_RATE_PER_MINUTE=30
LOGIN_RATE_PER_TEN_MINUTES=10
REGISTRATION_RATE_PER_HOUR=3
ALLOW_REGISTRATION=true
DEBUG_ENDPOINT_ENABLED=false
APP_ENV=production

# Pengiriman feedback melalui Gmail SMTP. Gunakan App Password, bukan password akun.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=alamat-pengirim@gmail.com
SMTP_PASSWORD=app_password_gmail
SMTP_FROM_EMAIL=alamat-pengirim@gmail.com
FEEDBACK_RECIPIENT=mwildankamil@gmail.com
FEEDBACK_SUBJECT=Feedback Muallaf Bot
# Satu pengiriman per IP setiap 900 detik (15 menit).
FEEDBACK_RATE_LIMIT_SECONDS=900
# Aktifkan hanya jika aplikasi berada di belakang reverse proxy tepercaya.
TRUST_PROXY_HEADERS=false
