FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Pilihan vector store: local_json, faiss.
# local_json adalah default stabil. faiss opsional dan perlu build knowledge base ulang.
VECTOR_DB_TYPE=local_json
# Pilihan: langchain, manual.
# langchain adalah engine utama. manual hanya untuk pembanding/legacy.
RAG_ENGINE=langchain
CHUNK_SIZE=900
CHUNK_OVERLAP=120
TOP_K=4
SIMILARITY_THRESHOLD=0.30

# Pilihan: auto, gemini, ollama.
# auto mencoba Gemini terlebih dahulu, lalu Ollama jika Gemini gagal/offline.
LLM_PROVIDER=auto
GEMINI_API_KEY=isi_api_key_gemini_di_file_env_lokal
GEMINI_MODEL=gemini-2.5-flash

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
